# Site-specific settings for the cluster scripts.
# Copy to lighthouse/local.env (ignored by git) and fill in. Plain KEY=VALUE lines.

# Where big files go: raw data, processed data, weights, run directories.
RV_SCRATCH=/scratch/<account_root>/<account>/<user>/Reality_View

# Optional. Put the raw Argoverse 2 Sensor logs somewhere else, for example next to other datasets.
# Default: $RV_SCRATCH/raw/argoverse2_sensor
# RV_RAW=/scratch/<account_root>/<account>/<user>/AV2/sensor

# Slurm account and partition used for jobs.
RV_ACCOUNT=<slurm_account>
RV_PARTITION=<slurm_partition>

# conda's shell hook on this cluster, e.g. <anaconda_root>/etc/profile.d/conda.sh
RV_CONDA_SH=<path/to/conda.sh>

# Optional. Name of the project's conda environment (default: realityview).
# RV_ENV=realityview

# Optional. Extra directories to search for an existing Argoverse 2 Sensor copy (space separated).
# RV_SEARCH_ROOTS="/scratch/<account_root>/<account>/shared_data"

# Where jobs copy their results (checkpoints, numbers, logs, overlay pictures): an rclone remote and path.
# Without it results stay on scratch.
# RV_NAS=<rclone remote>:<path>/Reality_View

# Optional. Processed data and run directories (defaults: $RV_SCRATCH/processed/av2_v1, $RV_SCRATCH/runs).
# RV_PROCESSED=/scratch/<account_root>/<account>/<user>/Reality_View/processed/av2_v1
# RV_RUNS=/scratch/<account_root>/<account>/<user>/Reality_View/runs
